server {
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    listen ${PORT_NGINX_EXTERNAL};

    location / {
        # Configuration index.html
        root /etc/nginx/html;
        index index.html;
        try_files $uri $uri/ =404;
    }

    location /dashboard/ {
        proxy_pass http://dashboard:${PORT_STREAMLIT_EXTERNAL}/dashboard/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        
        # Websockets Configuration - allow Streamlit accessibility on /dashboard/ and not on default /
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }
    
    location /api/ {
        proxy_pass http://api:${PORT_FASTAPI_EXTERNAL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Activate Swagger /docs/
        proxy_set_header X-Forwarded-Proto $scheme;
        #proxy_set_header X-Forwarded-Prefix /api;
    }
    
    location /api-backend/ {
        proxy_pass http://api-backend:${PORT_FASTAPI_BACKEND_EXTERNAL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Activate Swagger /docs/
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /mlflow/ {
        auth_request /api-backend/verify-backend-access;
        auth_request_set $auth_status $upstream_status;
        error_page 401 = /api-backend/login;
        
        # Specific Headers for MLflow
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Script-Name /mlflow;  # Important for MLflow
        
        # No rewrite, let MLflow roll
        # Name of mlflow server service in docker-compose.yml
        # replaced by makefile routine in compose section
        # pp http://mlflow-tracking:PORT_MLFLOW_TRACKING_EXTERNAL/;
        proxy_pass http://mlflow-tracking:${PORT_MLFLOW_TRACKING_EXTERNAL}/;
        
        # WebSockets configuration (if used)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # MLflow Static Assets
    location /mlflow/static/ {
        # Name of mlflow server service in docker-compose.yml
        # replaced by makefile routine in compose section
        # proxy_pass http://mlflow-tracking:PORT_MLFLOW_TRACKING_EXTERNAL/static/;
        proxy_pass http://mlflow-tracking:${PORT_MLFLOW_TRACKING_EXTERNAL}/static/;
        proxy_set_header Host $host;
    }

}
